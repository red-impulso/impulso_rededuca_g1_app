# Copiar a .env.local y completar. No subir secretos.
# Supabase: Project Settings → Data API. Usar la anon/public key, nunca la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL base de la API de Back (en local corre en el puerto 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000